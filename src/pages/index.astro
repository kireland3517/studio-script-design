---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Home"
  description="Studio Script Design — Healthcare operations consulting and compliance resources for peer support organizations. Get billing-ready fast."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-slate-900 to-teal-900 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
      <div class="max-w-3xl">
        <p class="text-teal-300 text-sm font-semibold uppercase tracking-widest mb-4">Session Supply Co.</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          Operations tools for<br class="hidden sm:block" /> peer support organizations
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 leading-relaxed mb-10 max-w-2xl">
          Practical, compliance-ready resources to help you bill Medicaid confidently, manage referrals efficiently, and grow your peer support program without the paperwork chaos.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/medicaid-ready"
            class="inline-block bg-teal-500 hover:bg-teal-400 text-white font-semibold px-7 py-3.5 rounded-lg transition-colors text-center"
          >
            MEDICAID-READY Kit
          </a>
          <a
            href="/admissions-pipeline-fix"
            class="inline-block bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold px-7 py-3.5 rounded-lg transition-colors text-center"
          >
            Admissions Pipeline Fix
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Products Section -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-3">Ready-to-use toolkits</h2>
      <p class="text-slate-500 text-center mb-12 max-w-xl mx-auto">Practical systems and templates built specifically for peer support and behavioral health organizations.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Product 1 -->
        <div class="bg-white rounded-2xl border border-slate-200 p-8 flex flex-col">
          <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">MEDICAID-READY</h3>
          <p class="text-slate-500 text-sm mb-1 font-medium uppercase tracking-wide">Medicaid Billing Compliance Kit</p>
          <p class="text-slate-600 mb-6 flex-grow">
            Everything your peer support organization needs to bill Medicaid correctly from day one — credentialing checklists, documentation templates, consent forms, and billing guidance built for compliance.
          </p>
          <a
            href="/medicaid-ready"
            class="inline-block bg-teal-700 hover:bg-teal-800 text-white font-semibold px-6 py-3 rounded-lg transition-colors text-center text-sm"
          >
            Learn More &rarr;
          </a>
        </div>

        <!-- Product 2 -->
        <div class="bg-white rounded-2xl border border-slate-200 p-8 flex flex-col">
          <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center mb-5">
            <svg class="w-5 h-5 text-indigo-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Admissions Pipeline Fix</h3>
          <p class="text-slate-500 text-sm mb-1 font-medium uppercase tracking-wide">Admissions & Referral Coordinator Toolkit</p>
          <p class="text-slate-600 mb-6 flex-grow">
            A complete system for admissions and referral coordinators — intake workflows, referral tracking templates, follow-up scripts, and reporting dashboards to keep your pipeline moving.
          </p>
          <a
            href="/admissions-pipeline-fix"
            class="inline-block bg-indigo-700 hover:bg-indigo-800 text-white font-semibold px-6 py-3 rounded-lg transition-colors text-center text-sm"
          >
            Learn More &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Blurb -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-5">Built by someone who's been in the weeds</h2>
        <p class="text-slate-600 leading-relaxed mb-6">
          I'm Katie Ireland, a freelance designer and healthcare operations consultant behind Studio Script Design. Session Supply Co. is where I put the tools I wish had existed — practical, field-tested resources for peer support organizations navigating Medicaid billing, referral management, and program operations.
        </p>
        <a href="/about" class="text-teal-700 font-semibold hover:text-teal-900 transition-colors">More about Katie &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Blog Preview -->
  {posts.length > 0 && (
    <section class="py-20 bg-slate-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">From the blog</h2>
          <a href="/blog" class="text-teal-700 font-medium text-sm hover:text-teal-900 transition-colors">All posts &rarr;</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {posts.map((post) => (
            <article class="bg-white rounded-xl border border-slate-200 p-6 hover:border-teal-200 hover:shadow-sm transition-all">
              <time class="text-xs text-slate-400 font-medium uppercase tracking-wide" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </time>
              <h3 class="font-semibold text-slate-900 mt-2 mb-3 leading-snug">
                <a href={`/blog/${post.id}`} class="hover:text-teal-700 transition-colors">{post.data.title}</a>
              </h3>
              <p class="text-slate-500 text-sm leading-relaxed line-clamp-3">{post.data.excerpt}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
