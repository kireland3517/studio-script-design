---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Blog"
  description="Articles on Medicaid billing, peer support compliance, admissions operations, and behavioral health program management — from Session Supply Co."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-3">Blog</h1>
      <p class="text-slate-500 text-lg">Practical guidance on Medicaid billing, peer support compliance, and behavioral health operations.</p>
    </div>

    <div class="divide-y divide-slate-100">
      {posts.map((post) => (
        <article class="py-8 group">
          <time class="text-xs text-slate-400 font-medium uppercase tracking-wide" datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </time>
          <h2 class="text-xl font-semibold text-slate-900 mt-2 mb-3 leading-snug group-hover:text-teal-700 transition-colors">
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
          </h2>
          <p class="text-slate-500 leading-relaxed mb-4">{post.data.excerpt}</p>
          <a
            href={`/blog/${post.id}`}
            class="text-sm font-medium text-teal-700 hover:text-teal-900 transition-colors"
          >
            Read article &rarr;
          </a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
