---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  canonicalURL?: string;
}

const {
  title,
  description = 'Session Supply Co. — Healthcare operations resources and compliance toolkits for peer support organizations.',
  ogTitle,
  ogDescription,
  canonicalURL,
} = Astro.props;

const GA_MEASUREMENT_ID = 'G-XXXXXXXXXX';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:site_name" content="Session Supply Co." />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />

    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <title>{title} | Session Supply Co.</title>

    <!-- Google Analytics -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID);
    </script>
  </head>
  <body class="bg-white text-slate-800 font-sans antialiased">
    <header class="border-b border-slate-100 bg-white sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex flex-col group">
          <span class="text-lg font-semibold tracking-tight text-slate-900 group-hover:text-teal-700 transition-colors leading-tight">
            Session Supply Co.
          </span>
          <span class="text-[10px] text-slate-400 tracking-wide leading-tight">by Studio Script Design</span>
        </a>
        <nav class="flex items-center gap-6 text-sm font-medium text-slate-600">
          <a href="/medicaid-ready" class="hover:text-teal-700 transition-colors hidden sm:block">MEDICAID-READY</a>
          <a href="/admissions-pipeline-fix" class="hover:text-teal-700 transition-colors hidden sm:block">Admissions Fix</a>
          <a href="/blog" class="hover:text-teal-700 transition-colors">Blog</a>
          <a href="/about" class="hover:text-teal-700 transition-colors">About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-slate-900 text-slate-400 mt-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mb-8">
          <div>
            <p class="text-white font-semibold mb-1">Session Supply Co.</p>
            <p class="text-slate-500 text-xs mb-3">by Studio Script Design</p>
            <p class="text-sm">Healthcare operations resources and compliance toolkits for peer support organizations.</p>
          </div>
          <div>
            <p class="text-white font-semibold mb-3">Products</p>
            <ul class="space-y-2 text-sm">
              <li><a href="/medicaid-ready" class="hover:text-teal-400 transition-colors">MEDICAID-READY Kit</a></li>
              <li><a href="/admissions-pipeline-fix" class="hover:text-teal-400 transition-colors">Admissions Pipeline Fix</a></li>
            </ul>
          </div>
          <div>
            <p class="text-white font-semibold mb-3">Links</p>
            <ul class="space-y-2 text-sm">
              <li><a href="/blog" class="hover:text-teal-400 transition-colors">Blog</a></li>
              <li><a href="/about" class="hover:text-teal-400 transition-colors">About</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-slate-800 pt-6 text-xs text-slate-500">
          <p>&copy; {new Date().getFullYear()} Studio Script Design. Session Supply Co. is a product line of Studio Script Design. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <!-- Gumroad overlay embed script -->
    <script src="https://gumroad.com/js/gumroad.js"></script>
  </body>
</html>
